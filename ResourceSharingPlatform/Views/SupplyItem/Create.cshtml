@model ResourceSharingPlatform.Models.SupplyItem
@using ResourceSharingPlatform.Models
@using System.Text.Json

@{
    ViewData["Title"] = "新增物資";
    var inventoryItemVariants = ViewBag.InventoryItemVariants as List<InventoryItemVariant> ?? new();
    var locationSafetyStocks = ViewBag.LocationSafetyStocks as List<LocationInventorySafetyStock> ?? new();
    int? selectedInventoryItemVariantId = ViewBag.SelectedInventoryItemVariantId;
    var locationSafetyJson = JsonSerializer.Serialize(locationSafetyStocks.Select(x => new
    {
        x.LocationId,
        x.InventoryItemDefinitionId,
        x.SafetyStock
    }));
    var variantsJson = JsonSerializer.Serialize(inventoryItemVariants.Select(v => new
    {
        VariantId = v.Id,
        DefinitionId = v.InventoryItemDefinition!.Id,
        v.InventoryItemDefinition!.Category,
        v.InventoryItemDefinition!.ItemName,
        v.Specification,
        v.InventoryItemDefinition!.Unit,
        v.InventoryItemDefinition!.StockType
    }));
}

<div class="container mt-4">
    <h2><i class="bi bi-box-seam"></i> 新增物資</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <h6 class="text-muted text-uppercase">分類</h6>
                        <div class="btn-group w-100 mb-3" role="group">
                            <input type="radio" class="btn-check" name="StockType" id="stockNoExpiry" value="@StockTypes.NoExpiry" autocomplete="off">
                            <label class="btn btn-outline-primary" for="stockNoExpiry">無效期物資</label>

                            <input type="radio" class="btn-check" name="StockType" id="stockHasExpiry" value="@StockTypes.HasExpiry" autocomplete="off" checked>
                            <label class="btn btn-outline-success" for="stockHasExpiry">有效期物資</label>

                            <input type="radio" class="btn-check" name="StockType" id="stockFrozen" value="@StockTypes.Frozen" autocomplete="off">
                            <label class="btn btn-outline-info" for="stockFrozen">冷凍食品</label>
                        </div>

                        <h6 class="text-muted text-uppercase mt-4">基本資料</h6>
                        @if (!inventoryItemVariants.Any())
                        {
                            <div class="alert alert-warning">
                                尚未建立可用的庫存種類設定，請聯絡管理員先至「系統管理 → 庫存種類設定」建立資料。
                            </div>
                        }
                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="categorySelect" class="form-label">物資種類 <span class="text-danger">*</span></label>
                                    <select id="categorySelect" class="form-select">
                                        <option value="">請選擇物資種類</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="itemNameSelect" class="form-label">物資名稱 <span class="text-danger">*</span></label>
                                    <select id="itemNameSelect" class="form-select" disabled>
                                        <option value="">請先選擇物資種類</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="specificationSelect" class="form-label">規格</label>
                                    <select id="specificationSelect" class="form-select" disabled>
                                        <option value="">請先選擇物資名稱</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" id="inventoryItemVariantId" name="inventoryItemVariantId" required />
                        <span class="text-danger field-validation-valid" data-valmsg-for="inventoryItemVariantId" data-valmsg-replace="true"></span>
                        <div id="variantSelectError" class="text-danger small mb-3" style="display:none;">請依序選擇物資種類、物資名稱與規格。</div>
                        <div class="form-text mb-3">下拉選單只會顯示符合上方「分類」的物資；選了物資種類才能選物資名稱，選了物資名稱才能選規格；選定後會自動帶入最小單位與安全庫存。切換上方分類會清空這裡已選的內容，因為可選的物資會跟著改變。</div>

                        <h6 class="text-muted text-uppercase mt-4">庫存與效期</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Quantity" class="form-label">目前數量 <span class="text-danger">*</span></label>
                                    <input asp-for="Quantity" class="form-control" type="number" min="0" />
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Unit" class="form-label">單位</label>
                                    <input asp-for="Unit" class="form-control" readonly />
                                    <span asp-validation-for="Unit" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="LocationId" class="form-label">所在據點 <span class="text-danger">*</span></label>
                                    <select asp-for="LocationId" asp-items="ViewBag.Locations" class="form-select">
                                        <option value="">請選擇據點</option>
                                    </select>
                                    <span asp-validation-for="LocationId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6" id="expirationWrap">
                                <div class="mb-3">
                                    <label asp-for="ExpirationDate" class="form-label">有效期限</label>
                                    <input asp-for="ExpirationDate" class="form-control" type="date" />
                                    <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                                    <small class="text-muted">無效期物資不需填寫</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SafetyStock" class="form-label">所在據點安全庫存</label>
                            <input asp-for="SafetyStock" class="form-control" type="number" min="0" readonly />
                            <span asp-validation-for="SafetyStock" class="text-danger"></span>
                            <small class="text-muted">由據點門檻設定帶入；相同物資的所有規格會合併計算。</small>
                        </div>

                        <h6 class="text-muted text-uppercase mt-4">圖片</h6>
                        <div class="mb-3">
                            <label class="form-label">物資圖片</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/png,image/jpeg,image/webp" />
                            <small class="text-muted">支援 jpg、png、webp，大小 5MB 以內</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Remark" class="form-label">備註</label>
                            <textarea asp-for="Remark" class="form-control" rows="3" placeholder="其他說明或注意事項"></textarea>
                            <span asp-validation-for="Remark" class="text-danger"></span>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> 確認新增
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> 返回列表
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="alert alert-info">
                <h6><i class="bi bi-info-circle"></i> 填寫說明</h6>
                <ul class="mb-0">
                    <li>標示 <span class="text-danger">*</span> 為必填欄位</li>
                    <li>選擇「無效期物資」時有效期限會自動隱藏</li>
                    <li>「有效期物資」「冷凍食品」必須填寫有效期限</li>
                    <li>安全庫存用於判斷是否低於警戒水位</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var wrap = document.getElementById('expirationWrap');
            var expirationInput = document.getElementById('ExpirationDate');
            var locationSelect = document.getElementById('LocationId');
            var locationSafetyStocks = @Html.Raw(locationSafetyJson);
            // Flat list of every active variant, each carrying its parent definition's
            // Category/ItemName/Unit. The three selects below are just progressively
            // narrower views over this one array - Category picks a subset, ItemName
            // narrows it further, Specification (the actual InventoryItemVariant rows)
            // is what's left, so their relationship to each other always stays intact.
            var variants = @Html.Raw(variantsJson);

            var categorySelect = document.getElementById('categorySelect');
            var itemNameSelect = document.getElementById('itemNameSelect');
            var specificationSelect = document.getElementById('specificationSelect');
            var hiddenVariantId = document.getElementById('inventoryItemVariantId');
            var unitInput = document.getElementById('Unit');
            var safetyStockInput = document.getElementById('SafetyStock');
            var variantError = document.getElementById('variantSelectError');

            function uniqueValues(list, keyFn) {
                var seen = {};
                var result = [];
                list.forEach(function (item) {
                    var key = keyFn(item);
                    if (!seen[key]) {
                        seen[key] = true;
                        result.push(item);
                    }
                });
                return result;
            }

            function fillSelect(select, items, valueFn, textFn, placeholder) {
                select.innerHTML = '';
                var placeholderOption = document.createElement('option');
                placeholderOption.value = '';
                placeholderOption.textContent = placeholder;
                select.appendChild(placeholderOption);
                items.forEach(function (item) {
                    var option = document.createElement('option');
                    option.value = valueFn(item);
                    option.textContent = textFn(item);
                    select.appendChild(option);
                });
            }

            function currentStockType() {
                var checked = document.querySelector('input[name="StockType"]:checked');
                return checked ? checked.value : '@StockTypes.HasExpiry';
            }

            function variantsForCurrentStockType() {
                var stockType = currentStockType();
                return variants.filter(function (v) { return v.StockType === stockType; });
            }

            function populateCategories(preselectCategory) {
                var categories = uniqueValues(variantsForCurrentStockType(), function (v) { return v.Category; });
                fillSelect(categorySelect, categories, function (v) { return v.Category; }, function (v) { return v.Category; }, '請選擇物資種類');
                if (preselectCategory) {
                    categorySelect.value = preselectCategory;
                }
            }

            function populateItemNames(preselectItemName) {
                var category = categorySelect.value;
                itemNameSelect.disabled = !category;
                if (!category) {
                    fillSelect(itemNameSelect, [], function () {}, function () {}, '請先選擇物資種類');
                    populateSpecifications();
                    return;
                }
                var names = uniqueValues(
                    variantsForCurrentStockType().filter(function (v) { return v.Category === category; }),
                    function (v) { return v.ItemName; }
                );
                fillSelect(itemNameSelect, names, function (v) { return v.ItemName; }, function (v) { return v.ItemName; }, '請選擇物資名稱');
                if (preselectItemName) {
                    itemNameSelect.value = preselectItemName;
                }
                populateSpecifications();
            }

            function populateSpecifications(preselectVariantId) {
                var category = categorySelect.value;
                var itemName = itemNameSelect.value;
                specificationSelect.disabled = !(category && itemName);
                if (!category || !itemName) {
                    fillSelect(specificationSelect, [], function () {}, function () {}, '請先選擇物資名稱');
                    resolveVariant();
                    return;
                }
                var matches = variantsForCurrentStockType().filter(function (v) { return v.Category === category && v.ItemName === itemName; });
                fillSelect(specificationSelect, matches, function (v) { return v.VariantId; }, function (v) { return v.Specification || '無規格'; }, '請選擇規格');
                if (preselectVariantId) {
                    specificationSelect.value = preselectVariantId;
                } else if (matches.length === 1) {
                    // Only one specification for this item - no real choice to make, so
                    // just resolve it instead of making the user click a one-option dropdown.
                    specificationSelect.value = matches[0].VariantId;
                }
                resolveVariant();
            }

            function resolveVariant() {
                var variantId = specificationSelect.value;
                var variant = variants.find(function (v) { return String(v.VariantId) === String(variantId); });
                hiddenVariantId.value = variant ? variant.VariantId : '';
                unitInput.value = variant ? variant.Unit : '';
                variantError.style.display = 'none';
                applyLocationSafety(variant ? variant.DefinitionId : null);
            }

            function applyLocationSafety(definitionId) {
                var locationId = Number(locationSelect.value || 0);
                var defId = Number(definitionId || 0);
                var setting = locationSafetyStocks.find(function (x) {
                    return x.LocationId === locationId && x.InventoryItemDefinitionId === defId;
                });
                safetyStockInput.value = setting ? setting.SafetyStock : 0;
            }

            function update() {
                var val = currentStockType();
                if (val === '@StockTypes.NoExpiry') {
                    wrap.style.display = 'none';
                    expirationInput.required = false;
                } else {
                    wrap.style.display = '';
                    expirationInput.required = true;
                }
            }

            function onStockTypeChanged() {
                update();
                // The set of valid 物資種類/名稱/規格 depends on which 分類 is selected, so
                // whatever was already picked there may no longer be valid - clear it and
                // rebuild the category list from scratch for the newly selected 分類.
                populateCategories();
                populateItemNames();
            }

            document.querySelectorAll('input[name="StockType"]').forEach(function (r) {
                r.addEventListener('change', onStockTypeChanged);
            });
            categorySelect.addEventListener('change', function () { populateItemNames(); });
            itemNameSelect.addEventListener('change', function () { populateSpecifications(); });
            specificationSelect.addEventListener('change', resolveVariant);
            locationSelect.addEventListener('change', function () {
                var variant = variants.find(function (v) { return String(v.VariantId) === String(specificationSelect.value); });
                applyLocationSafety(variant ? variant.DefinitionId : null);
            });

            document.querySelector('form').addEventListener('submit', function (e) {
                if (!hiddenVariantId.value) {
                    e.preventDefault();
                    variantError.style.display = '';
                    categorySelect.focus();
                }
            });

            // Restore the previous selection (StockType/Category/ItemName/Specification)
            // after a failed submit, so the user doesn't have to re-pick everything from
            // scratch. The StockType radio has to be restored first since it determines
            // which categories/items/specs are even offered.
            var selectedVariantId = @(selectedInventoryItemVariantId.HasValue ? selectedInventoryItemVariantId.Value.ToString() : "null");
            var selectedVariant = selectedVariantId ? variants.find(function (v) { return v.VariantId === selectedVariantId; }) : null;
            if (selectedVariant) {
                var radio = document.querySelector('input[name="StockType"][value="' + selectedVariant.StockType + '"]');
                if (radio) { radio.checked = true; }
            }

            populateCategories(selectedVariant ? selectedVariant.Category : null);
            populateItemNames(selectedVariant ? selectedVariant.ItemName : null);
            populateSpecifications(selectedVariant ? selectedVariant.VariantId : null);
            update();
        })();
    </script>
}
