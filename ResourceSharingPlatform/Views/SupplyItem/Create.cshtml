@model ResourceSharingPlatform.Models.SupplyItem
@using ResourceSharingPlatform.Models
@using System.Text.Json

@{
    ViewData["Title"] = "新增物資";
    var inventoryItemVariants = ViewBag.InventoryItemVariants as List<InventoryItemVariant> ?? new();
    var locationSafetyStocks = ViewBag.LocationSafetyStocks as List<LocationInventorySafetyStock> ?? new();
    int? selectedInventoryItemVariantId = ViewBag.SelectedInventoryItemVariantId;
    var locationSafetyJson = JsonSerializer.Serialize(locationSafetyStocks.Select(x => new
    {
        x.LocationId,
        x.InventoryItemDefinitionId,
        x.SafetyStock
    }));
}

<div class="container mt-4">
    <h2><i class="bi bi-box-seam"></i> 新增物資</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <h6 class="text-muted text-uppercase">分類</h6>
                        <div class="btn-group w-100 mb-3" role="group">
                            <input type="radio" class="btn-check" name="StockType" id="stockNoExpiry" value="@StockTypes.NoExpiry" autocomplete="off">
                            <label class="btn btn-outline-primary" for="stockNoExpiry">無效期物資</label>

                            <input type="radio" class="btn-check" name="StockType" id="stockHasExpiry" value="@StockTypes.HasExpiry" autocomplete="off" checked>
                            <label class="btn btn-outline-success" for="stockHasExpiry">有效期物資</label>

                            <input type="radio" class="btn-check" name="StockType" id="stockFrozen" value="@StockTypes.Frozen" autocomplete="off">
                            <label class="btn btn-outline-info" for="stockFrozen">冷凍食品</label>
                        </div>

                        <h6 class="text-muted text-uppercase mt-4">基本資料</h6>
                        <div class="mb-3">
                            <label for="inventoryItemVariantId" class="form-label">庫存種類與規格 <span class="text-danger">*</span></label>
                            <select id="inventoryItemVariantId" name="inventoryItemVariantId" class="form-select" required>
                                <option value="">請選擇預設物資與規格</option>
                                @foreach (var variant in inventoryItemVariants)
                                {
                                    var definition = variant.InventoryItemDefinition!;
                                    <option value="@variant.Id"
                                            data-definition-id="@definition.Id"
                                            data-category="@definition.Category"
                                            data-item-name="@definition.ItemName"
                                            data-specification="@variant.Specification"
                                            data-unit="@definition.Unit"
                                            selected="@(selectedInventoryItemVariantId == variant.Id ? "selected" : null)">
                                        @definition.DisplayName｜@variant.DisplayName
                                    </option>
                                }
                            </select>
                            <span class="text-danger field-validation-valid" data-valmsg-for="inventoryItemVariantId" data-valmsg-replace="true"></span>
                            <div class="form-text">選擇後會自動帶入物資種類、名稱、規格與最小單位。</div>
                            @if (!inventoryItemVariants.Any())
                            {
                                <div class="alert alert-warning mt-2 mb-0">
                                    尚未建立可用的庫存種類設定，請聯絡管理員先至「系統管理 → 庫存種類設定」建立資料。
                                </div>
                            }
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Category" class="form-label">物資種類 <span class="text-danger">*</span></label>
                                    <input asp-for="Category" class="form-control" readonly />
                                    <span asp-validation-for="Category" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ItemName" class="form-label">物資名稱 <span class="text-danger">*</span></label>
                                    <input asp-for="ItemName" class="form-control" readonly />
                                    <span asp-validation-for="ItemName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Specification" class="form-label">規格</label>
                            <input asp-for="Specification" class="form-control" readonly />
                            <span asp-validation-for="Specification" class="text-danger"></span>
                        </div>

                        <h6 class="text-muted text-uppercase mt-4">庫存與效期</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Quantity" class="form-label">目前數量 <span class="text-danger">*</span></label>
                                    <input asp-for="Quantity" class="form-control" type="number" min="0" />
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Unit" class="form-label">單位</label>
                                    <input asp-for="Unit" class="form-control" readonly />
                                    <span asp-validation-for="Unit" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="LocationId" class="form-label">所在據點 <span class="text-danger">*</span></label>
                                    <select asp-for="LocationId" asp-items="ViewBag.Locations" class="form-select">
                                        <option value="">請選擇據點</option>
                                    </select>
                                    <span asp-validation-for="LocationId" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6" id="expirationWrap">
                                <div class="mb-3">
                                    <label asp-for="ExpirationDate" class="form-label">有效期限</label>
                                    <input asp-for="ExpirationDate" class="form-control" type="date" />
                                    <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                                    <small class="text-muted">無效期物資不需填寫</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SafetyStock" class="form-label">所在據點安全庫存</label>
                            <input asp-for="SafetyStock" class="form-control" type="number" min="0" readonly />
                            <span asp-validation-for="SafetyStock" class="text-danger"></span>
                            <small class="text-muted">由據點門檻設定帶入；相同物資的所有規格會合併計算。</small>
                        </div>

                        <h6 class="text-muted text-uppercase mt-4">圖片</h6>
                        <div class="mb-3">
                            <label class="form-label">物資圖片</label>
                            <input type="file" name="imageFile" class="form-control" accept="image/png,image/jpeg,image/webp" />
                            <small class="text-muted">支援 jpg、png、webp，大小 5MB 以內</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Remark" class="form-label">備註</label>
                            <textarea asp-for="Remark" class="form-control" rows="3" placeholder="其他說明或注意事項"></textarea>
                            <span asp-validation-for="Remark" class="text-danger"></span>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> 確認新增
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> 返回列表
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="alert alert-info">
                <h6><i class="bi bi-info-circle"></i> 填寫說明</h6>
                <ul class="mb-0">
                    <li>標示 <span class="text-danger">*</span> 為必填欄位</li>
                    <li>選擇「無效期物資」時有效期限會自動隱藏</li>
                    <li>「有效期物資」「冷凍食品」必須填寫有效期限</li>
                    <li>安全庫存用於判斷是否低於警戒水位</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var wrap = document.getElementById('expirationWrap');
            var input = document.getElementById('ExpirationDate');
            var presetSelect = document.getElementById('inventoryItemVariantId');
            var locationSelect = document.getElementById('LocationId');
            var locationSafetyStocks = @Html.Raw(locationSafetyJson);

            function applyLocationSafety() {
                var option = presetSelect.options[presetSelect.selectedIndex];
                var definitionId = Number(option.dataset.definitionId || 0);
                var locationId = Number(locationSelect.value || 0);
                var setting = locationSafetyStocks.find(function (x) {
                    return x.LocationId === locationId && x.InventoryItemDefinitionId === definitionId;
                });
                document.getElementById('SafetyStock').value = setting ? setting.SafetyStock : 0;
            }

            function applyPreset() {
                var option = presetSelect.options[presetSelect.selectedIndex];
                document.getElementById('Category').value = option.dataset.category || '';
                document.getElementById('ItemName').value = option.dataset.itemName || '';
                document.getElementById('Specification').value = option.dataset.specification || '';
                document.getElementById('Unit').value = option.dataset.unit || '';
                applyLocationSafety();
            }

            function update() {
                var checked = document.querySelector('input[name="StockType"]:checked');
                var val = checked ? checked.value : '@StockTypes.HasExpiry';
                if (val === '@StockTypes.NoExpiry') {
                    wrap.style.display = 'none';
                    input.required = false;
                } else {
                    wrap.style.display = '';
                    input.required = true;
                }
            }

            document.querySelectorAll('input[name="StockType"]').forEach(function (r) {
                r.addEventListener('change', update);
            });
            presetSelect.addEventListener('change', applyPreset);
            locationSelect.addEventListener('change', applyLocationSafety);
            if (presetSelect.value) {
                applyPreset();
            }
            update();
        })();
    </script>
}
