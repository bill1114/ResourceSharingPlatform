<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 地方物資管理平台</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ResourceSharingPlatform.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-box-seam"></i> 地方物資管理平台
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> 戰情總覽
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="Map" asp-action="Index">
                                    <i class="bi bi-geo-alt"></i> 據點地圖
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="SupplyItem" asp-action="Index">
                                    <i class="bi bi-box"></i> 物資管理
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-controller="SupplyLocation" asp-action="Index">
                                    <i class="bi bi-buildings"></i> 據點管理
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-arrow-left-right"></i> 物資異動
                                </a>
                                <ul class="dropdown-menu">
                                    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Cadre))
                                    {
                                        <li><a class="dropdown-item" asp-controller="SupplyTransfer" asp-action="Create"><i class="bi bi-arrow-left-right"></i> 物資轉移</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-controller="SupplyTransfer" asp-action="Index"><i class="bi bi-list-ul"></i> 轉移紀錄</a></li>
                                    <li><a class="dropdown-item" asp-controller="SupplyOutbound" asp-action="Create"><i class="bi bi-box-arrow-up"></i> 物資出庫</a></li>
                                    <li><a class="dropdown-item" asp-controller="SupplyOutbound" asp-action="Index"><i class="bi bi-list-ul"></i> 出庫紀錄</a></li>
                                    <li><a class="dropdown-item" asp-controller="SupplyDonation" asp-action="Create"><i class="bi bi-gift"></i> 物資捐贈</a></li>
                                    <li><a class="dropdown-item" asp-controller="SupplyDonation" asp-action="Index"><i class="bi bi-award"></i> 捐贈紀錄</a></li>
                                    <li><a class="dropdown-item" asp-controller="SupplyDisposal" asp-action="Create"><i class="bi bi-trash3"></i> 物資報廢</a></li>
                                    <li><a class="dropdown-item" asp-controller="SupplyDisposal" asp-action="Index"><i class="bi bi-list-ul"></i> 報廢紀錄</a></li>
                                    <li><a class="dropdown-item" asp-controller="AIStockIn" asp-action="Create"><i class="bi bi-stars"></i> AI 智慧入庫</a></li>
                                    <li><a class="dropdown-item" asp-controller="AIStockIn" asp-action="Index"><i class="bi bi-list-ul"></i> AI 辨識紀錄</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-graph-up"></i> 分析報表
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="SupplyOutbound" asp-action="RecipientAnalysis"><i class="bi bi-graph-up"></i> 領取分析</a></li>
                                </ul>
                            </li>
                            @if (User.IsInRole(Roles.Admin))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-gear"></i> 系統管理
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="UserAccount" asp-action="Index"><i class="bi bi-people"></i> 帳號管理</a></li>
                                        <li><a class="dropdown-item" asp-controller="LineNotification" asp-action="Settings"><i class="bi bi-chat-dots"></i> LINE 通知設定</a></li>
                                        <li><a class="dropdown-item" asp-controller="AIStockIn" asp-action="Settings"><i class="bi bi-stars"></i> AI 智慧入庫設定</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item d-flex align-items-center text-white me-3">
                                <i class="bi bi-person-circle"></i>
                                <span class="ms-1">@(User.FindFirst("DisplayName")?.Value ?? User.Identity!.Name)</span>
                                <span class="badge bg-light text-dark ms-2">@Roles.ToDisplayName(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-light">
                                        <i class="bi bi-box-arrow-right"></i> 登出
                                    </button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5 py-3 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    &copy; 2025 - 地方物資管理平台
                </div>
                <div class="col-md-6 text-end">
                    <i class="bi bi-info-circle"></i> 用於管理地方據點物資現況、庫存數量、有效期限與轉移紀錄
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
