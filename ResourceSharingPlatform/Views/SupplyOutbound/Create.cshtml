@model ResourceSharingPlatform.Models.ViewModels.OutboundViewModel
@using ResourceSharingPlatform.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Text.Json

@{
    ViewData["Title"] = "物資出庫";
    var expiringItems = ViewBag.ExpiringItems as List<SupplyItem>;
    var itemOptions = (List<SupplyItem>)ViewBag.Items;
    int? lockedLocationId = ViewBag.LockedLocationId;
    var lockedLocationName = lockedLocationId.HasValue
        ? ((SelectList)ViewBag.Locations).FirstOrDefault(x => x.Value == lockedLocationId.Value.ToString())?.Text
        : null;

    string StockTypeBtnClass(string stockType) => stockType switch
    {
        StockTypes.NoExpiry => "btn-outline-primary",
        StockTypes.HasExpiry => "btn-outline-success",
        StockTypes.Frozen => "btn-outline-info",
        _ => "btn-outline-secondary"
    };

    var itemsJson = JsonSerializer.Serialize(itemOptions.Select(opt =>
    {
        var today = DateTime.Today;
        var warning = opt.ExpirationDate.HasValue && opt.ExpirationDate.Value < today
            ? "已過期"
            : opt.ExpirationDate.HasValue && opt.ExpirationDate.Value <= today.AddDays(30)
                ? "即將過期"
                : null;
        return new
        {
            Id = opt.Id,
            opt.Category,
            opt.ItemName,
            opt.Specification,
            opt.Unit,
            opt.Quantity,
            opt.LocationId,
            opt.StockType,
            opt.ImagePath,
            ExpirationDate = opt.ExpirationDate.HasValue ? opt.ExpirationDate.Value.ToString("yyyy-MM-dd") : null,
            Warning = warning
        };
    }));
}

<div class="container mt-4">
    <h2><i class="bi bi-box-arrow-up"></i> 物資出庫（發放）</h2>
    <hr />

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (expiringItems != null && expiringItems.Any())
    {
        <div class="alert alert-warning">
            <h6><i class="bi bi-exclamation-triangle-fill"></i> 即期／已過期物資，建議優先出庫</h6>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>物資</th>
                            <th>據點</th>
                            <th>庫存</th>
                            <th>有效期限</th>
                            <th>狀態</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ex in expiringItems)
                        {
                            <tr>
                                <td>@ex.ItemName</td>
                                <td><span class="badge" style="@LocationColors.Style(ex.LocationId)"><i class="bi bi-building"></i> @ex.Location?.LocationName</span></td>
                                <td>@ex.Quantity @ex.Unit</td>
                                <td>@ex.ExpirationDate?.ToString("yyyy-MM-dd")</td>
                                <td><span class="badge @ex.GetStatusBadgeClass()">@ex.GetStatus()</span></td>
                                <td>
                                    <a asp-action="Create" asp-route-supplyItemId="@ex.Id" asp-route-locationId="@ex.LocationId" class="btn btn-sm btn-outline-warning">選擇出庫</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label class="form-label">據點 <span class="text-danger">*</span></label>
                            @if (lockedLocationId.HasValue)
                            {
                                <input type="text" class="form-control" value="@lockedLocationName" disabled />
                                <input type="hidden" name="LocationId" id="LocationId" value="@lockedLocationId" />
                                <div class="form-text">您的帳號僅能對所屬據點執行出庫。</div>
                            }
                            else
                            {
                                <select asp-for="LocationId" asp-items="ViewBag.Locations" id="LocationId" class="form-select">
                                    <option value="">請選擇據點</option>
                                </select>
                            }
                            <span asp-validation-for="LocationId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">分類</label>
                            <div class="btn-group w-100" role="group" id="stockTypeFilter">
                                <input type="radio" class="btn-check" name="stockTypeFilter" id="filterAll" value="" checked autocomplete="off">
                                <label class="btn btn-outline-secondary" for="filterAll">全部</label>
                                @foreach (var st in StockTypes.All)
                                {
                                    <input type="radio" class="btn-check" name="stockTypeFilter" id="filter_@st" value="@st" autocomplete="off">
                                    <label class="btn @StockTypeBtnClass(st)" for="filter_@st">@StockTypes.ToDisplayName(st)</label>
                                }
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="categorySelect" class="form-label">物資種類 <span class="text-danger">*</span></label>
                                    <select id="categorySelect" class="form-select">
                                        <option value="">請選擇物資種類</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="itemNameSelect" class="form-label">物資名稱 <span class="text-danger">*</span></label>
                                    <select id="itemNameSelect" class="form-select" disabled>
                                        <option value="">請先選擇物資種類</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label for="specificationSelect" class="form-label">規格／批次 <span class="text-danger">*</span></label>
                                    <select id="specificationSelect" class="form-select" disabled>
                                        <option value="">請先選擇物資名稱</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <input type="hidden" asp-for="SupplyItemId" id="SupplyItemId" />
                        <span asp-validation-for="SupplyItemId" class="text-danger"></span>
                        <div id="itemSelectError" class="text-danger small mb-2" style="display:none;">請依序選擇據點、分類、物資種類、物資名稱與規格。</div>

                        <div class="mb-3 p-3 bg-light rounded border d-flex align-items-center gap-3" id="itemPreview" style="display:none;">
                            <img id="itemPreviewImg" src="" alt="物資照片" style="width:140px;height:140px;object-fit:cover;flex-shrink:0;display:none;" class="rounded border" />
                            <i id="itemPreviewNoImg" class="bi bi-image text-muted flex-shrink-0" style="font-size:5rem;display:none;"></i>
                            <div class="d-flex flex-column gap-2">
                                <span id="itemPreviewQtyBadge" class="badge fs-5 fw-normal align-self-start">
                                    <i class="bi bi-box-seam"></i> 現有 <span id="itemPreviewQty"></span>
                                </span>
                                <span id="itemPreviewExpiryBadge" class="badge fs-5 fw-normal align-self-start"></span>
                            </div>
                        </div>
                        <div class="form-text mb-3">下拉選單只會顯示所選據點與分類下的物資；選了物資種類才能選物資名稱，選了物資名稱才能選規格／批次；切換據點或分類會清空已選內容。依有效期限由近到遠排序，即期／已過期物資已加註提醒。</div>

                        <div class="mb-3">
                            <label asp-for="OutboundQuantity" class="form-label">出庫數量 <span class="text-danger">*</span></label>
                            <input asp-for="OutboundQuantity" class="form-control" type="number" min="1" placeholder="請輸入出庫數量" />
                            <span asp-validation-for="OutboundQuantity" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="RecipientName" class="form-label">領用人姓名 <span class="text-danger">*</span></label>
                                    <input asp-for="RecipientName" class="form-control" placeholder="例如：陳先生" />
                                    <span asp-validation-for="RecipientName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="RecipientContact" class="form-label">領用人聯絡方式</label>
                                    <input asp-for="RecipientContact" class="form-control" placeholder="例如：手機或地址" />
                                    <span asp-validation-for="RecipientContact" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">操作人員</label>
                            <input class="form-control" value="@(User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name)" disabled />
                            <div class="form-text">系統會自動記錄目前登入帳號為操作人員。</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Remark" class="form-label">備註</label>
                            <textarea asp-for="Remark" class="form-control" rows="3" placeholder="發放原因或其他說明"></textarea>
                            <span asp-validation-for="Remark" class="text-danger"></span>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> 確認出庫
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> 返回紀錄
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="alert alert-info">
                <h6><i class="bi bi-info-circle"></i> 出庫說明</h6>
                <ul class="mb-0">
                    <li>先選擇據點，物資選單會自動只顯示該據點的物資</li>
                    <li>可搭配分類快速篩選（無效期／有效期／冷凍食品）</li>
                    <li>出庫後物資會直接離開系統庫存，不會轉入其他據點</li>
                    <li>系統會自動檢查庫存是否足夠</li>
                </ul>
            </div>

            <div class="alert alert-warning">
                <h6><i class="bi bi-exclamation-triangle"></i> 注意事項</h6>
                <ul class="mb-0">
                    <li>請確認出庫數量正確</li>
                    <li>出庫後無法直接復原</li>
                    <li>建議填寫領用人聯絡方式以利後續追蹤</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var locationInput = document.getElementById('LocationId');
            var categorySelect = document.getElementById('categorySelect');
            var itemNameSelect = document.getElementById('itemNameSelect');
            var specificationSelect = document.getElementById('specificationSelect');
            var hiddenItemId = document.getElementById('SupplyItemId');
            var itemError = document.getElementById('itemSelectError');
            var preview = document.getElementById('itemPreview');
            var previewImg = document.getElementById('itemPreviewImg');
            var previewNoImg = document.getElementById('itemPreviewNoImg');
            var previewQty = document.getElementById('itemPreviewQty');
            var previewQtyBadge = document.getElementById('itemPreviewQtyBadge');
            var previewExpiryBadge = document.getElementById('itemPreviewExpiryBadge');
            var stockTypeInputs = document.querySelectorAll('input[name="stockTypeFilter"]');

            // Every active SupplyItem row (already scoped to what this user is allowed to
            // issue from). 據點 and 分類 narrow this down first, then the three cascading
            // selects (物資種類/物資名稱/規格) narrow it further, same pattern as 新增物資 -
            // except the final "規格" level here resolves straight to a concrete SupplyItem
            // (batch/expiry included in its label) instead of a catalog variant, since outbound
            // has to act on one specific stock row.
            var items = @Html.Raw(itemsJson);

            function currentLocationId() {
                return locationInput ? locationInput.value : '';
            }

            function currentStockType() {
                var checked = document.querySelector('input[name="stockTypeFilter"]:checked');
                return checked ? checked.value : '';
            }

            function candidateItems() {
                var locVal = currentLocationId();
                var stockVal = currentStockType();
                return items.filter(function (it) {
                    return (!locVal || String(it.LocationId) === String(locVal)) &&
                        (!stockVal || it.StockType === stockVal);
                });
            }

            function uniqueValues(list, keyFn) {
                var seen = {};
                var result = [];
                list.forEach(function (item) {
                    var key = keyFn(item);
                    if (!seen[key]) {
                        seen[key] = true;
                        result.push(item);
                    }
                });
                return result;
            }

            function fillSelect(select, list, valueFn, textFn, placeholder) {
                select.innerHTML = '';
                var placeholderOption = document.createElement('option');
                placeholderOption.value = '';
                placeholderOption.textContent = placeholder;
                select.appendChild(placeholderOption);
                list.forEach(function (item) {
                    var option = document.createElement('option');
                    option.value = valueFn(item);
                    option.textContent = textFn(item);
                    select.appendChild(option);
                });
            }

            function specOptionText(it) {
                var text = (it.Specification || '無規格') + ' - 現有 ' + it.Quantity + ' ' + (it.Unit || '');
                text += it.ExpirationDate ? '（效期 ' + it.ExpirationDate + '）' : '（無期限）';
                if (it.Warning) { text += ' ⚠' + it.Warning; }
                return text;
            }

            function populateCategories(preselect) {
                var categories = uniqueValues(candidateItems(), function (it) { return it.Category; });
                fillSelect(categorySelect, categories, function (it) { return it.Category; }, function (it) { return it.Category; }, '請選擇物資種類');
                if (preselect) { categorySelect.value = preselect; }
            }

            function populateItemNames(preselect) {
                var category = categorySelect.value;
                itemNameSelect.disabled = !category;
                if (!category) {
                    fillSelect(itemNameSelect, [], function () {}, function () {}, '請先選擇物資種類');
                    populateSpecifications();
                    return;
                }
                var names = uniqueValues(
                    candidateItems().filter(function (it) { return it.Category === category; }),
                    function (it) { return it.ItemName; }
                );
                fillSelect(itemNameSelect, names, function (it) { return it.ItemName; }, function (it) { return it.ItemName; }, '請選擇物資名稱');
                if (preselect) { itemNameSelect.value = preselect; }
                populateSpecifications();
            }

            function populateSpecifications(preselectId) {
                var category = categorySelect.value;
                var itemName = itemNameSelect.value;
                specificationSelect.disabled = !(category && itemName);
                if (!category || !itemName) {
                    fillSelect(specificationSelect, [], function () {}, function () {}, '請先選擇物資名稱');
                    resolveItem();
                    return;
                }
                var matches = candidateItems().filter(function (it) { return it.Category === category && it.ItemName === itemName; });
                fillSelect(specificationSelect, matches, function (it) { return it.Id; }, specOptionText, '請選擇規格／批次');
                if (preselectId) {
                    specificationSelect.value = preselectId;
                } else if (matches.length === 1) {
                    specificationSelect.value = matches[0].Id;
                }
                resolveItem();
            }

            function resolveItem() {
                var id = specificationSelect.value;
                var item = items.find(function (it) { return String(it.Id) === String(id); });
                hiddenItemId.value = item ? item.Id : '';
                itemError.style.display = 'none';

                if (!item) {
                    preview.style.display = 'none';
                    return;
                }

                preview.style.display = '';
                if (item.ImagePath) {
                    previewImg.src = item.ImagePath;
                    previewImg.style.display = '';
                    previewNoImg.style.display = 'none';
                } else {
                    previewImg.style.display = 'none';
                    previewNoImg.style.display = '';
                }

                previewQty.textContent = item.Quantity + ' ' + (item.Unit || '');
                previewQtyBadge.className = 'badge fs-5 fw-normal align-self-start ' + (item.Quantity > 0 ? 'bg-primary' : 'bg-danger');

                var expiryClass = 'bg-secondary';
                var expiryText = '無期限';
                if (item.ExpirationDate) {
                    expiryText = '效期 ' + item.ExpirationDate;
                    if (item.Warning === '已過期') { expiryClass = 'bg-dark'; expiryText += ' ⚠已過期'; }
                    else if (item.Warning === '即將過期') { expiryClass = 'bg-warning text-dark'; expiryText += ' ⚠即將過期'; }
                    else { expiryClass = 'bg-success'; }
                }
                previewExpiryBadge.className = 'badge fs-5 fw-normal align-self-start ' + expiryClass;
                previewExpiryBadge.innerHTML = '<i class="bi bi-calendar-event"></i> ' + expiryText;
            }

            function onFilterChanged() {
                populateCategories();
                populateItemNames();
            }

            if (locationInput && locationInput.tagName === 'SELECT') {
                locationInput.addEventListener('change', onFilterChanged);
            }
            stockTypeInputs.forEach(function (input) {
                input.addEventListener('change', onFilterChanged);
            });
            categorySelect.addEventListener('change', function () { populateItemNames(); });
            itemNameSelect.addEventListener('change', function () { populateSpecifications(); });
            specificationSelect.addEventListener('change', resolveItem);

            document.querySelector('form').addEventListener('submit', function (e) {
                if (!hiddenItemId.value) {
                    e.preventDefault();
                    itemError.style.display = '';
                    categorySelect.focus();
                }
            });

            // Restore the previous selection - either from the "選擇出庫" quick-link
            // (supplyItemId query string, surfaced via Model.SupplyItemId) or after a failed
            // submit - so the 分類/物資種類/物資名稱/規格 don't have to be re-picked from scratch.
            var selectedId = @(Model.SupplyItemId > 0 ? Model.SupplyItemId.ToString() : "null");
            var selectedItem = selectedId ? items.find(function (it) { return String(it.Id) === String(selectedId); }) : null;
            if (selectedItem) {
                var radio = document.querySelector('input[name="stockTypeFilter"][value="' + selectedItem.StockType + '"]');
                if (radio) { radio.checked = true; }
            }

            populateCategories(selectedItem ? selectedItem.Category : null);
            populateItemNames(selectedItem ? selectedItem.ItemName : null);
            populateSpecifications(selectedItem ? selectedItem.Id : null);
        })();
    </script>
}
