@model IEnumerable<ResourceSharingPlatform.Models.UserAccount>
@using ResourceSharingPlatform.Models

@{
    ViewData["Title"] = "帳號管理";
    var keyword = ViewBag.Keyword as string;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-people"></i> 帳號管理</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> 新增帳號
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <i class="bi bi-funnel"></i> 篩選條件
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">關鍵字</label>
                        <input type="text" name="keyword" value="@keyword" class="form-control" placeholder="帳號、顯示名稱" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-search"></i> 搜尋
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-clockwise"></i> 重設
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>帳號</th>
                        <th>顯示名稱</th>
                        <th>角色</th>
                        <th>所屬據點</th>
                        <th>狀態</th>
                        <th>建立時間</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.UserName</td>
                            <td>@user.DisplayName</td>
                            <td><span class="badge bg-secondary">@Roles.ToDisplayName(user.RoleName)</span></td>
                            <td>
                                @if (user.Location != null)
                                {
                                    <span class="badge" style="@LocationColors.Style(user.LocationId!.Value)"><i class="bi bi-building"></i> @user.Location.LocationName</span>
                                }
                                else
                                {
                                    <span class="text-muted">未指定</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">啟用中</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">已停用</span>
                                }
                            </td>
                            <td>@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> 編輯
                                </a>
                                @if (user.IsActive)
                                {
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-person-dash"></i> 停用
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
