@model ResourceSharingPlatform.Models.ViewModels.UserAccountViewModel
@using ResourceSharingPlatform.Models

@{
    ViewData["Title"] = "新增帳號";
}

<div class="container mt-4">
    <h2><i class="bi bi-person-plus"></i> 新增帳號</h2>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label">帳號 <span class="text-danger">*</span></label>
                            <input asp-for="UserName" class="form-control" placeholder="例如：cadre01" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">密碼 <span class="text-danger">*</span></label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DisplayName" class="form-label">顯示名稱</label>
                            <input asp-for="DisplayName" class="form-control" placeholder="例如：王小明" />
                            <span asp-validation-for="DisplayName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="RoleName" class="form-label">角色 <span class="text-danger">*</span></label>
                            <select asp-for="RoleName" class="form-select">
                                @foreach (var role in Roles.All)
                                {
                                    <option value="@role">@Roles.ToDisplayName(role)</option>
                                }
                            </select>
                            <span asp-validation-for="RoleName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LocationId" class="form-label">所屬據點</label>
                            <select asp-for="LocationId" asp-items="ViewBag.Locations" class="form-select">
                                <option value="">（未指定）</option>
                            </select>
                            <span asp-validation-for="LocationId" class="text-danger"></span>
                            <div class="form-text">幹部／社工需指定所屬據點，才能確認／取消送達至該據點的物資轉移。</div>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label">啟用此帳號</label>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> 確認新增
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> 返回列表
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
