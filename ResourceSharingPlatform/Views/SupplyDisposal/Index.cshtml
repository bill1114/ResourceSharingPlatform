@model IEnumerable<ResourceSharingPlatform.Models.SupplyDisposalLog>
@using ResourceSharingPlatform.Models

@{
    ViewData["Title"] = "報廢紀錄";
    var expiringItems = ViewBag.ExpiringItems as List<SupplyItem>;
    var isAdmin = User.IsInRole(Roles.Admin);
    var hasLocation = int.TryParse(User.FindFirst("LocationId")?.Value, out _);
    var keyword = ViewBag.Keyword as string;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-trash3"></i> 物資報廢紀錄</h2>
        <div>
            <a asp-action="ExportExcel" asp-route-keyword="@keyword" class="btn btn-outline-success">
                <i class="bi bi-file-earmark-excel"></i> 匯出 Excel
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> 新增報廢登記
            </a>
        </div>
    </div>

    @if (!isAdmin && !hasLocation)
    {
        <div class="alert alert-secondary">
            <i class="bi bi-info-circle"></i> 您的帳號尚未指定所屬據點，無法執行報廢，請聯絡管理人員設定。
        </div>
    }

    @if (expiringItems != null && expiringItems.Any())
    {
        <div class="alert alert-warning">
            <h6><i class="bi bi-exclamation-triangle-fill"></i> 即期／已過期物資，建議優先確認是否報廢（共 @expiringItems.Count 項）</h6>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>物資</th>
                            <th>據點</th>
                            <th>庫存</th>
                            <th>有效期限</th>
                            <th>狀態</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ex in expiringItems)
                        {
                            <tr>
                                <td>@ex.ItemName</td>
                                <td><span class="badge" style="@LocationColors.Style(ex.LocationId)"><i class="bi bi-building"></i> @ex.Location?.LocationName</span></td>
                                <td>@ex.Quantity @ex.Unit</td>
                                <td>@ex.ExpirationDate?.ToString("yyyy-MM-dd")</td>
                                <td><span class="badge @ex.GetStatusBadgeClass()">@ex.GetStatus()</span></td>
                                <td>
                                    <a asp-action="Create" asp-route-supplyItemId="@ex.Id" asp-route-locationId="@ex.LocationId" class="btn btn-sm btn-outline-primary">選擇報廢</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <i class="bi bi-funnel"></i> 篩選條件
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">關鍵字</label>
                        <input type="text" name="keyword" value="@keyword" class="form-control" placeholder="物資名稱、操作人員、備註" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-search"></i> 搜尋
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-clockwise"></i> 重設
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> 沒有符合條件的報廢紀錄，請<a asp-action="Create" class="alert-link">建立報廢登記</a>。
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>報廢時間</th>
                                <th>物資名稱</th>
                                <th>據點</th>
                                <th>報廢數量</th>
                                <th>報廢原因</th>
                                <th>操作人員</th>
                                <th>備註</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td>@log.DisposalTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><strong>@log.SupplyItem?.ItemName</strong></td>
                                    <td>
                                        <span class="badge" style="@LocationColors.Style(log.LocationId)">
                                            <i class="bi bi-building"></i> @log.Location?.LocationName
                                        </span>
                                    </td>
                                    <td class="text-end"><strong>@log.DisposalQuantity</strong> @log.SupplyItem?.Unit</td>
                                    <td><span class="badge @DisposalReasons.ToBadgeClass(log.Reason)">@DisposalReasons.ToDisplayName(log.Reason)</span></td>
                                    <td>@log.Operator</td>
                                    <td>@log.Remark</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <p class="text-muted mb-0">
                        <i class="bi bi-info-circle"></i> 顯示最近 100 筆報廢紀錄
                    </p>
                </div>
            </div>
        </div>
    }
</div>
