@model ResourceSharingPlatform.Models.ViewModels.DisposalViewModel
@using ResourceSharingPlatform.Models
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "物資報廢";
    var expiringItems = ViewBag.ExpiringItems as List<SupplyItem>;
    var itemOptions = (List<SupplyItem>)ViewBag.Items;
    int? lockedLocationId = ViewBag.LockedLocationId;
    var lockedLocationName = lockedLocationId.HasValue
        ? ((SelectList)ViewBag.Locations).FirstOrDefault(x => x.Value == lockedLocationId.Value.ToString())?.Text
        : null;
}

@functions {
    string ItemOptionText(SupplyItem opt)
    {
        var today = DateTime.Today;
        var text = opt.ItemName + " (" + (opt.Location?.LocationName ?? "") + ") - 現有 " + opt.Quantity + " " + opt.Unit;
        if (opt.ExpirationDate.HasValue && opt.ExpirationDate.Value < today) text += " ⚠已過期";
        else if (opt.ExpirationDate.HasValue && opt.ExpirationDate.Value <= today.AddDays(30)) text += " ⚠即將過期";
        return text;
    }
}

<div class="container mt-4">
    <h2><i class="bi bi-trash3"></i> 物資報廢／損耗登記</h2>
    <hr />

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (expiringItems != null && expiringItems.Any())
    {
        <div class="alert alert-warning">
            <h6><i class="bi bi-exclamation-triangle-fill"></i> 即期／已過期物資，建議優先確認是否報廢</h6>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>物資</th>
                            <th>據點</th>
                            <th>庫存</th>
                            <th>有效期限</th>
                            <th>狀態</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ex in expiringItems)
                        {
                            <tr>
                                <td>@ex.ItemName</td>
                                <td><span class="badge" style="@LocationColors.Style(ex.LocationId)"><i class="bi bi-building"></i> @ex.Location?.LocationName</span></td>
                                <td>@ex.Quantity @ex.Unit</td>
                                <td>@ex.ExpirationDate?.ToString("yyyy-MM-dd")</td>
                                <td><span class="badge @ex.GetStatusBadgeClass()">@ex.GetStatus()</span></td>
                                <td>
                                    <a asp-action="Create" asp-route-supplyItemId="@ex.Id" asp-route-locationId="@ex.LocationId" class="btn btn-sm btn-outline-primary">選擇報廢</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label class="form-label">據點 <span class="text-danger">*</span></label>
                            @if (lockedLocationId.HasValue)
                            {
                                <input type="text" class="form-control" value="@lockedLocationName" disabled />
                                <input type="hidden" name="LocationId" id="LocationId" value="@lockedLocationId" />
                                <div class="form-text">您的帳號僅能對所屬據點執行報廢。</div>
                            }
                            else
                            {
                                <select asp-for="LocationId" asp-items="ViewBag.Locations" id="LocationId" class="form-select">
                                    <option value="">請選擇據點</option>
                                </select>
                            }
                            <span asp-validation-for="LocationId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SupplyItemId" class="form-label">選擇物資 <span class="text-danger">*</span></label>
                            <select asp-for="SupplyItemId" id="itemSelect" class="form-select">
                                <option value="">請選擇物資</option>
                                @foreach (var opt in itemOptions)
                                {
                                    <option value="@opt.Id" data-location-id="@opt.LocationId" selected="@(opt.Id == Model.SupplyItemId)">@ItemOptionText(opt)</option>
                                }
                            </select>
                            <span asp-validation-for="SupplyItemId" class="text-danger"></span>
                            <div class="form-text">依有效期限由近到遠排序，即期／已過期物資已加註提醒。</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DisposalQuantity" class="form-label">報廢數量 <span class="text-danger">*</span></label>
                            <input asp-for="DisposalQuantity" class="form-control" type="number" min="1" placeholder="請輸入報廢數量" />
                            <span asp-validation-for="DisposalQuantity" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Reason" class="form-label">報廢原因 <span class="text-danger">*</span></label>
                            <select asp-for="Reason" class="form-select">
                                @foreach (var r in DisposalReasons.All)
                                {
                                    <option value="@r">@DisposalReasons.ToDisplayName(r)</option>
                                }
                            </select>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">操作人員</label>
                            <input class="form-control" value="@(User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name)" disabled />
                            <div class="form-text">系統會自動記錄目前登入帳號為操作人員。</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Remark" class="form-label">備註</label>
                            <textarea asp-for="Remark" class="form-control" rows="3" placeholder="報廢原因說明或其他備註"></textarea>
                            <span asp-validation-for="Remark" class="text-danger"></span>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> 確認報廢
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> 返回紀錄
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="alert alert-info">
                <h6><i class="bi bi-info-circle"></i> 報廢說明</h6>
                <ul class="mb-0">
                    <li>先選擇據點，物資選單會自動只顯示該據點的物資</li>
                    <li>報廢後物資會直接離開系統庫存</li>
                    <li>系統會自動檢查庫存是否足夠</li>
                </ul>
            </div>

            <div class="alert alert-warning">
                <h6><i class="bi bi-exclamation-triangle"></i> 注意事項</h6>
                <ul class="mb-0">
                    <li>請確認報廢數量正確</li>
                    <li>報廢後無法直接復原</li>
                    <li>建議選擇正確的報廢原因以利後續統計</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var locationInput = document.getElementById('LocationId');
            var itemSelect = document.getElementById('itemSelect');

            function filterItems() {
                var locVal = locationInput ? locationInput.value : '';
                var currentValid = false;

                itemSelect.querySelectorAll('option[data-location-id]').forEach(function (opt) {
                    var show = !locVal || opt.getAttribute('data-location-id') === locVal;
                    opt.style.display = show ? '' : 'none';
                    if (show && opt.value === itemSelect.value) {
                        currentValid = true;
                    }
                });

                if (!currentValid) {
                    itemSelect.value = '';
                }
            }

            if (locationInput && locationInput.tagName === 'SELECT') {
                locationInput.addEventListener('change', filterItems);
            }

            filterItems();
        })();
    </script>
}
