@model ResourceSharingPlatform.Models.ViewModels.InventoryDefinitionFormViewModel
@{ ViewData["Title"] = "編輯庫存種類"; }

<div class="container mt-4">
    <h2><i class="bi bi-pencil-square"></i> 編輯庫存種類</h2><hr />
    <div class="card shadow-sm"><div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input asp-for="Id" type="hidden" />
            <partial name="_Form" model="Model" />
            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">啟用，供新增物資時選擇</label>
            </div>
            <button class="btn btn-primary" type="submit"><i class="bi bi-check-circle"></i> 儲存變更</button>
            <a asp-action="Index" class="btn btn-secondary">返回列表</a>
        </form>
    </div></div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
