@model ResourceSharingPlatform.Models.ViewModels.AIStockInViewModel
@using ResourceSharingPlatform.Models

@{
    ViewData["Title"] = "確認 AI 辨識結果";
    var log = ViewBag.Log as AIStockInLog;
}

<div class="container mt-4">
    <h2><i class="bi bi-stars"></i> 確認 AI 辨識結果</h2>
    <hr />

    @if (log != null)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> @log.RawResponse
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light">
                <i class="bi bi-camera"></i> 本次輸入內容（@AIStockInInputTypes.ToDisplayName(log.InputType)）
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(log.InputImagePath))
                {
                    <img src="@log.InputImagePath" alt="輸入照片" style="max-width:240px;max-height:240px;object-fit:cover;" class="rounded border" />
                }
                @if (!string.IsNullOrEmpty(log.InputText))
                {
                    <p class="mb-0">@log.InputText</p>
                }
                <p class="text-muted small mb-0 mt-2">
                    <i class="bi bi-building"></i> @log.Location?.LocationName
                    <i class="bi bi-clock"></i> @log.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </p>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Confirm" asp-route-id="@log?.Id" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="LocationId" />

                        <h6 class="text-muted text-uppercase">分類</h6>
                        <div class="btn-group w-100 mb-3" role="group">
                            <input type="radio" class="btn-check" name="StockType" id="stockNoExpiry" value="@StockTypes.NoExpiry" autocomplete="off" checked="@(Model.StockType == StockTypes.NoExpiry)">
                            <label class="btn btn-outline-primary" for="stockNoExpiry">無效期物資</label>

                            <input type="radio" class="btn-check" name="StockType" id="stockHasExpiry" value="@StockTypes.HasExpiry" autocomplete="off" checked="@(Model.StockType == StockTypes.HasExpiry)">
                            <label class="btn btn-outline-success" for="stockHasExpiry">有效期物資</label>

                            <input type="radio" class="btn-check" name="StockType" id="stockFrozen" value="@StockTypes.Frozen" autocomplete="off" checked="@(Model.StockType == StockTypes.Frozen)">
                            <label class="btn btn-outline-info" for="stockFrozen">冷凍食品</label>
                        </div>

                        <h6 class="text-muted text-uppercase mt-4">基本資料</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Category" class="form-label">物資種類 <span class="text-danger">*</span></label>
                                    <input asp-for="Category" class="form-control" placeholder="例如：食品、醫療、防護" list="categoryList" />
                                    <datalist id="categoryList">
                                        <option value="食品"></option>
                                        <option value="醫療"></option>
                                        <option value="防護"></option>
                                        <option value="生活"></option>
                                        <option value="工具"></option>
                                    </datalist>
                                    <span asp-validation-for="Category" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="ItemName" class="form-label">物資名稱 <span class="text-danger">*</span></label>
                                    <input asp-for="ItemName" class="form-control" placeholder="例如：飲用水" />
                                    <span asp-validation-for="ItemName" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Specification" class="form-label">規格</label>
                            <input asp-for="Specification" class="form-control" placeholder="例如：500ml、大／中／小" />
                            <span asp-validation-for="Specification" class="text-danger"></span>
                        </div>

                        <h6 class="text-muted text-uppercase mt-4">庫存與效期</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Quantity" class="form-label">目前數量 <span class="text-danger">*</span></label>
                                    <input asp-for="Quantity" class="form-control" type="number" min="0" />
                                    <span asp-validation-for="Quantity" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Unit" class="form-label">單位</label>
                                    <input asp-for="Unit" class="form-control" placeholder="例如：瓶、箱、組、件" list="unitList" />
                                    <datalist id="unitList">
                                        <option value="瓶"></option>
                                        <option value="箱"></option>
                                        <option value="組"></option>
                                        <option value="件"></option>
                                        <option value="片"></option>
                                        <option value="包"></option>
                                    </datalist>
                                    <span asp-validation-for="Unit" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6" id="expirationWrap">
                                <div class="mb-3">
                                    <label asp-for="ExpirationDate" class="form-label">有效期限</label>
                                    <input asp-for="ExpirationDate" class="form-control" type="date" />
                                    <span asp-validation-for="ExpirationDate" class="text-danger"></span>
                                    <small class="text-muted">無效期物資不需填寫</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">所在據點</label>
                                    <input type="text" class="form-control" value="@log?.Location?.LocationName" disabled />
                                    <small class="text-muted">據點於「AI 辨識」步驟選擇，這裡不能更改</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SafetyStock" class="form-label">安全庫存 <span class="text-danger">*</span></label>
                            <input asp-for="SafetyStock" class="form-control" type="number" min="0" />
                            <span asp-validation-for="SafetyStock" class="text-danger"></span>
                            <small class="text-muted">當數量低於此值時會顯示警告</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Remark" class="form-label">備註</label>
                            <textarea asp-for="Remark" class="form-control" rows="3" placeholder="其他說明或注意事項"></textarea>
                            <span asp-validation-for="Remark" class="text-danger"></span>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> 確認並建立物資
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> 取消
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="alert alert-warning">
                <h6><i class="bi bi-exclamation-triangle"></i> 請務必核對</h6>
                <ul class="mb-0">
                    <li>AI 建議僅供參考，請核對品項與數量正確無誤</li>
                    <li>若據點已有相同物資（品項/種類/規格/分類/效期皆相同），會自動合併數量</li>
                    <li>確認送出後才會真的寫入庫存</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        (function () {
            var wrap = document.getElementById('expirationWrap');
            var input = document.getElementById('ExpirationDate');

            function update() {
                var checked = document.querySelector('input[name="StockType"]:checked');
                var val = checked ? checked.value : '@StockTypes.HasExpiry';
                if (val === '@StockTypes.NoExpiry') {
                    wrap.style.display = 'none';
                    input.required = false;
                } else {
                    wrap.style.display = '';
                    input.required = true;
                }
            }

            document.querySelectorAll('input[name="StockType"]').forEach(function (r) {
                r.addEventListener('change', update);
            });
            update();
        })();
    </script>
}
