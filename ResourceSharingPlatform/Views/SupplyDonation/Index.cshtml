@model IEnumerable<ResourceSharingPlatform.Models.SupplyDonationLog>
@using ResourceSharingPlatform.Models
@using ResourceSharingPlatform.Models.ViewModels

@{
    ViewData["Title"] = "捐贈紀錄與芳名錄";
    var keyword = ViewBag.Keyword as string;
    var donorSummary = ViewBag.DonorSummary as List<DonorSummaryViewModel>;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-list-ul"></i> 捐贈紀錄與芳名錄</h2>
        <div>
            <a asp-action="ExportExcel" asp-route-keyword="@keyword" class="btn btn-outline-success">
                <i class="bi bi-file-earmark-excel"></i> 匯出 Excel
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> 新增捐贈登記
            </a>
        </div>
    </div>

    @if (donorSummary != null && donorSummary.Any())
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center" style="cursor:pointer;" data-bs-toggle="collapse" data-bs-target="#donorSummaryBody">
                <span><i class="bi bi-award"></i> 捐物者芳名錄（共 @donorSummary.Count 位捐贈者）</span>
                <i class="bi bi-chevron-up"></i>
            </div>
            <div class="collapse show" id="donorSummaryBody">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>捐贈者</th>
                                    <th>聯絡方式</th>
                                    <th>捐贈次數</th>
                                    <th>捐贈品項數</th>
                                    <th>首次捐贈</th>
                                    <th>最近捐贈</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in donorSummary)
                                {
                                    <tr>
                                        <td><strong>@d.DonorName</strong></td>
                                        <td>@d.DonorContact</td>
                                        <td>@d.DonationCount</td>
                                        <td>@d.DistinctItemCount</td>
                                        <td>@d.FirstDonationDate.ToString("yyyy-MM-dd")</td>
                                        <td>@d.LastDonationDate.ToString("yyyy-MM-dd")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <i class="bi bi-funnel"></i> 篩選條件
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">關鍵字</label>
                        <input type="text" name="keyword" value="@keyword" class="form-control" placeholder="物資名稱、捐贈者姓名、聯絡方式、操作人員、備註" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-search"></i> 搜尋
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-clockwise"></i> 重設
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> 沒有符合條件的捐贈紀錄，請<a asp-action="Create" class="alert-link">建立捐贈登記</a>。
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>捐贈時間</th>
                                <th>物資名稱</th>
                                <th>據點</th>
                                <th>捐贈數量</th>
                                <th>捐贈者</th>
                                <th>聯絡方式</th>
                                <th>操作人員</th>
                                <th>備註</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model)
                            {
                                <tr>
                                    <td>@log.DonationTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><strong>@log.SupplyItem?.ItemName</strong></td>
                                    <td>
                                        <span class="badge" style="@LocationColors.Style(log.LocationId)">
                                            <i class="bi bi-building"></i> @log.Location?.LocationName
                                        </span>
                                    </td>
                                    <td class="text-end"><strong>@log.DonationQuantity</strong> @log.SupplyItem?.Unit</td>
                                    <td>@log.DonorName</td>
                                    <td>@log.DonorContact</td>
                                    <td>@log.Operator</td>
                                    <td>@log.Remark</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <p class="text-muted mb-0">
                        <i class="bi bi-info-circle"></i> 顯示最近 100 筆捐贈紀錄
                    </p>
                </div>
            </div>
        </div>
    }
</div>
