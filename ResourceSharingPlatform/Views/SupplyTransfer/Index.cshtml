@model IEnumerable<ResourceSharingPlatform.Models.SupplyTransferLog>
@using ResourceSharingPlatform.Models

@{
    ViewData["Title"] = "物資轉移紀錄";
    var canCreate = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Cadre);
    var isAdmin = User.IsInRole(Roles.Admin);
    int? myLocationId = int.TryParse(User.FindFirst("LocationId")?.Value, out var parsedLocationId) ? parsedLocationId : null;
    var keyword = ViewBag.Keyword as string;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-list-ul"></i> 物資轉移紀錄</h2>
        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> 新增轉移
            </a>
        }
    </div>

    @if (!isAdmin && myLocationId == null && (User.IsInRole(Roles.Cadre) || User.IsInRole(Roles.SocialWorker)) && Model.Any(x => x.Status == TransferStatuses.Pending))
    {
        <div class="alert alert-secondary">
            <i class="bi bi-info-circle"></i> 您的帳號尚未指定所屬據點，無法確認／取消送達至任何據點的轉移，請聯絡管理人員設定。
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <i class="bi bi-funnel"></i> 篩選條件
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label">關鍵字</label>
                        <input type="text" name="keyword" value="@keyword" class="form-control" placeholder="物資名稱、操作人員、備註" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="bi bi-search"></i> 搜尋
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-clockwise"></i> 重設
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> 沒有符合條件的轉移紀錄。
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>轉移時間</th>
                                <th>物資名稱</th>
                                <th>來源據點</th>
                                <th><i class="bi bi-arrow-right"></i></th>
                                <th>目標據點</th>
                                <th>轉移數量</th>
                                <th>狀態</th>
                                <th>操作人員</th>
                                <th>備註</th>
                                <th>動作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model)
                            {
                                var canResolve = isAdmin || (myLocationId.HasValue && myLocationId.Value == log.ToLocationId);
                                <tr>
                                    <td>@log.TransferTime.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td><strong>@log.SupplyItem?.ItemName</strong></td>
                                    <td>
                                        <span class="badge" style="@LocationColors.Style(log.FromLocationId)">
                                            <i class="bi bi-building"></i> @log.FromLocation?.LocationName
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <i class="bi bi-arrow-right-circle text-primary"></i>
                                    </td>
                                    <td>
                                        <span class="badge" style="@LocationColors.Style(log.ToLocationId)">
                                            <i class="bi bi-building"></i> @log.ToLocation?.LocationName
                                        </span>
                                    </td>
                                    <td class="text-end"><strong>@log.TransferQuantity</strong> @log.SupplyItem?.Unit</td>
                                    <td>
                                        <span class="badge @TransferStatuses.ToBadgeClass(log.Status)">@TransferStatuses.ToDisplayName(log.Status)</span>
                                        @if (log.Status != TransferStatuses.Pending && log.ConfirmedBy != null)
                                        {
                                            <div class="small text-muted">@log.ConfirmedBy @log.ConfirmedAt?.ToString("yyyy-MM-dd HH:mm")</div>
                                        }
                                    </td>
                                    <td>@log.Operator</td>
                                    <td>@log.Remark</td>
                                    <td>
                                        @if (log.Status == TransferStatuses.Pending && canResolve)
                                        {
                                            <form asp-action="ConfirmReceipt" asp-route-id="@log.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success" title="確認送達">
                                                    <i class="bi bi-check-lg"></i> 確認送達
                                                </button>
                                            </form>
                                            <form asp-action="CancelTransfer" asp-route-id="@log.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="取消轉移">
                                                    <i class="bi bi-x-lg"></i> 取消
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <p class="text-muted mb-0">
                        <i class="bi bi-info-circle"></i> 顯示最近 100 筆轉移紀錄，即使是同一批送出的物資，也可以分別逐筆確認送達或取消
                    </p>
                </div>
            </div>
        </div>
    }
</div>
